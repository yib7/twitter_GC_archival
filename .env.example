# NOTE: nothing in this project auto-loads .env — there is no dotenv
# dependency and no process.loadEnvFile() call anywhere in scripts/ or the app.
# Copying this file to .env does NOTHING by itself. Every variable below only
# takes effect if YOU export it into the shell's environment before running a
# command, e.g. (bash) `GCA_PORT=9000 node scripts/server.js`, or
# (PowerShell) `$env:GCA_PORT=9000; node scripts/server.js`.

# Port for the local server (default: 8765). Safe to change for normal use —
# e.g. if 8765 is already taken.
# GCA_PORT=8765

# --- Everything below is for TEST/DEV use only — do not set these for normal
# --- day-to-day use of the app. ---

# GCA_PERSONAL relocates where the server reads/writes identity + built data
# (config.json, data.js, local.js, source/, media/, pfps/). Tests set this to a
# throwaway temp directory so they never touch your real personal_data/.
#
# Hazard: do NOT relocate this to a folder INSIDE the repo (e.g.
# ./my_data) for real use. Only the default personal_data/ (and matching
# personal_data*/ patterns) is covered by .gitignore/eslint's ignore list — a
# relocated in-repo folder's config.json, local.js, pfps/, and media/ are NOT
# ignored, so `git add .` would commit real names and photos. It also breaks
# served media, since the server only serves /personal_data/media/. If you
# need a different location, point it OUTSIDE this repo entirely
# (e.g. an absolute path under your home directory).
# GCA_PERSONAL=/absolute/path/outside/this/repo

# PLAYWRIGHT_BASE_URL points the e2e suite at an ALREADY-RUNNING server instead
# of letting playwright.config.js spawn its own isolated one.
#
# Hazard: setting this turns OFF the test harness's own webServer
# (fresh temp GCA_PERSONAL, dedicated port, GCA_NO_ROOT_FALLBACK) and points
# the suite at whatever is already listening on the given port — including,
# if you happen to run this from the wrong checkout or port, your REAL
# archive server. Leave this unset unless you specifically need to test
# against a separately-managed server, and never point it at anything but a
# server you just started with an empty/throwaway GCA_PERSONAL.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:8799

# CI environment indicator — set by GitHub Actions automatically. You should
# not need to set this yourself.
# CI=
