# ============================================================================
#  PRIVATE DATA — never commit. This repo ships only synthetic sample data.
# ============================================================================

# All real, user-specific data lives here: config.json, the built data.js,
# local.js (names/pfps/me/GC), copied media, and profile/group photos.
# Written by the setup wizard (served at /setup.html) — never commit.
# Glob covers backups too (e.g. personal_data.REAL/ created during testing).
personal_data*/

# Built archive (real messages) — regenerate with `node scripts/build.js`
data.js
# The build also writes data.js.bak (the archive before the last merge: real messages)
# and data.js.<pid>.<hex>.tmp next to data.js; keep those out too if the folder is relocated.
data.js.*

# Raw Twitter/X exports (full content + headers, 1:1 + group). These two globs already
# cover direct-messages.js, direct-messages-group.js, direct-message-headers.js, and
# direct-message-group-headers.js — no need to list each exact filename separately.
direct-messages*.js
direct-message-*.js

# Media folders (real photos & videos)
direct_messages_media/
direct_messages_group_media/
# The pre-wizard manual setup (v1.0) kept photos at the top level; a checkout
# upgraded from it may still hold them.
profile_pictures/
gc_photo.jpg

# Private local overrides (real names / profile pictures), e.g. the legacy root
# names.local.js. Any *.local.js, to match the lint ignore list.
*.local.js

# Packaged export archives (multi-GB) and other archive formats — never commit
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Private audit reports (they can quote real ids)
*_Audit_Report*.md
*Deep_Audit*.md

# Raw export staging folder (real export files dropped here before setup)
exports/

# Key and certificate material: none belongs in this repo
*.pem
*.key

# Local environment files. Nothing here reads one (the optional variables are
# set in the shell, see README), but a stray .env could hold someone's secrets.
.env
.env.*

# Editor / IDE / tool / AI session files — never published
.claude/
CLAUDE.md
.autopilot/
.superpowers/
.vscode/
.idea/

# Dependencies
node_modules/

# Playwright test artifacts (playwright-report/ is the HTML reporter's output,
# which CI uploads when a run fails)
test-results/
playwright-report/

# Internal planning brief (references real ids / private data). Bare pattern, so
# it matches PLAN.md at any depth.
PLAN.md

# Brainstorming / design specs (work-in-progress notes, reference private data)
docs/superpowers/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
