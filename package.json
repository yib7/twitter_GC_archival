{
  "name": "group-chat-archive",
  "version": "1.3.0",
  "private": true,
  "description": "Offline browser for Twitter/X group DM exports.",
  "scripts": {
    "start": "node scripts/server.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:e2e": "playwright test",
    "test:big": "node -e \"process.env.GCA_BIG='1';require('child_process').execFileSync(process.execPath,['--test','tests/build-600mb.big.js'],{stdio:'inherit'})\"",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  }
}
